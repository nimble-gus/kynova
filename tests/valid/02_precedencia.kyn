// Precedencia: * y / antes que + y -, asociatividad izquierda
splice adam a = 2 + 3 * 4;          // 2 + (3 * 4) = 14
splice adam b = (2 + 3) * 4;        // agrupación explícita = 20
splice adam c = 20 - 5 - 3;         // (20 - 5) - 3 = 12
splice eve  d = 10 / 4 * 2.5;       // (10 / 4) * 2.5
splice eve  average = 85.50;

// adam -> eve es válido (no se pierde información)
average = average + a;
d = b;

diary(a);
diary(b);
diary(c);
diary(d);
diary(average);
